# ใช้โปรเจกต์ Supabase ชุดเดียวกับเว็บ (root .env.local)
# ค่า URL และ anon key ต้องตรงกับ NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_PROMPTPAY_ID=0812345678
EXPO_PUBLIC_PROMPTPAY_NAME=FastHelp
