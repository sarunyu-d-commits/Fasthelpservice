@startuml
title ภาพที่ 3-3 แผนภาพความสัมพันธ์ของฐานข้อมูล (ER Diagram)

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Tahoma
skinparam defaultFontColor #000000
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 4
skinparam linetype ortho
skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam titleFontSize 17
skinparam titleFontColor #000000
skinparam entityBackgroundColor #FFFFFF
skinparam entityBorderColor #000000
skinparam entityFontColor #000000
skinparam noteBackgroundColor #F7F7F7
skinparam noteBorderColor #000000

hide circle
hide empty methods

entity "auth.users\n(Supabase Auth)" as auth_users {
  * id : uuid <<PK>>
  --
  email : text
  encrypted_password : text
  raw_user_meta_data : jsonb
}

entity "profiles" as profiles {
  * id : uuid <<PK, FK>>
  --
  full_name : text
  phone : text
  role : text\n(customer / provider / admin)
  avatar_url : text
  created_at : timestamptz
}

entity "provider_profiles" as provider_profiles {
  * id : uuid <<PK, FK>>
  --
  bio : text
  service_area : text
  years_experience : integer
  is_verified : boolean
  is_available : boolean
  rating_avg : numeric(3,2)
  rating_count : integer
  created_at : timestamptz
}

entity "provider_services" as provider_services {
  * provider_id : uuid <<PK, FK>>
  * service_id : uuid <<PK, FK>>
}

entity "services" as services {
  * id : uuid <<PK>>
  --
  slug : text <<unique>>
  name : text
  description : text
  category : text
  icon : text
  base_price : integer
  unit : text
  duration_minutes : integer
  is_active : boolean
  sort_order : integer
  created_at : timestamptz
}

entity "bookings" as bookings {
  * id : uuid <<PK>>
  --
  customer_id : uuid <<FK>>
  provider_id : uuid <<FK, null>>
  service_id : uuid <<FK>>
  status : text\n(pending / accepted /\nin_progress / completed /\ncancelled)
  scheduled_at : timestamptz
  address : text
  notes : text
  latitude : double precision
  longitude : double precision
  location_label : text
  price : integer
  payment_status : text\n(unpaid / pending / paid /\nrefunded)
  payment_method : text
  created_at : timestamptz
  updated_at : timestamptz
}

entity "messages" as messages {
  * id : uuid <<PK>>
  --
  * booking_id : uuid <<FK>>
  * sender_id : uuid <<FK>>
  body : text
  message_type : text\n(text / location / image)
  latitude : double precision
  longitude : double precision
  location_label : text
  image_path : text\n(private storage)
  expires_at : timestamptz
  created_at : timestamptz
}

entity "booking_reads" as booking_reads {
  * booking_id : uuid <<PK, FK>>
  * user_id : uuid <<PK, FK>>
  --
  last_read_at : timestamptz
}

entity "push_subscriptions" as push_subscriptions {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  endpoint : text
  p256dh : text
  auth : text
  created_at : timestamptz
}

entity "reviews" as reviews {
  * id : uuid <<PK>>
  --
  booking_id : uuid <<FK, unique>>
  customer_id : uuid <<FK>>
  provider_id : uuid <<FK>>
  rating : integer (1-5)
  comment : text
  created_at : timestamptz
}

auth_users ||--|| profiles : "สร้างโปรไฟล์อัตโนมัติ"
profiles ||--o| provider_profiles : "เป็นช่าง"
profiles ||--o{ provider_services : "รับบริการ"
services ||--o{ provider_services : "ถูกเลือกโดยช่าง"
profiles ||--o{ bookings : "ลูกค้าจอง"
profiles ||--o{ bookings : "ช่างรับงาน"
services ||--o{ bookings : "อ้างอิงบริการ"
bookings ||--o{ messages : "สนทนา"
bookings ||--o{ booking_reads : "สถานะอ่าน / นับข้อความยังไม่ได้อ่าน"
profiles ||--o{ booking_reads : "อ่านข้อความ"
profiles ||--o{ push_subscriptions : "สมัครแจ้งเตือน Web Push"
bookings ||--o| reviews : "มีรีวิวได้ 1 ครั้ง"
profiles ||--o{ reviews : "ลูกค้าเขียนรีวิว"
profiles ||--o{ reviews : "ช่างได้รับรีวิว"

note right of bookings #F7F7F7
  Trigger guard_booking_update
  ล็อก customer_id, service_id, price
  และตรวจลำดับสถานะ
end note

note right of provider_profiles #F7F7F7
  Trigger guard_provider_verification
  ช่างแก้ is_verified เองไม่ได้
  เฉพาะ admin เท่านั้น
end note

note bottom of messages #F7F7F7
  อยู่ใน supabase_realtime (INSERT/UPDATE)
  replica identity full → polling 4s เป็น fallback
end note

note bottom of booking_reads #F7F7F7
  อยู่ใน supabase_realtime → read receipt แบบทันที
end note

note bottom of reviews #F7F7F7
  Trigger refresh_provider_rating
  อัปเดต rating_avg / rating_count
  อัตโนมัติเมื่อมีรีวิว
end note

@enduml
