@startuml
title ภาพที่ 3-6 แผนภาพการติดตั้งและเผยแพร่ (Deployment Diagram)

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Tahoma
skinparam defaultFontColor #000000
skinparam defaultFontSize 14
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #000000
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 12
skinparam titleFontSize 17
skinparam titleFontColor #000000
skinparam nodeBackgroundColor #FFFFFF
skinparam nodeBorderColor #000000
skinparam cloudBackgroundColor #FFFFFF
skinparam cloudBorderColor #000000
skinparam artifactBackgroundColor #FFFFFF
skinparam artifactBorderColor #000000
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #000000
skinparam noteBackgroundColor #F7F7F7
skinparam noteBorderColor #000000

node "เครื่องผู้ใช้" {
  artifact "เบราว์เซอร์ / PWA" as Browser
  artifact "/sw.js (Service Worker)\npush · notificationclick" as SW
}

cloud "GitHub" {
  component "main branch (push)" as GH
}

node "Vercel — Production" {
  component "Auto Deploy\nlint · typecheck · test · build" as CI
  component "Next.js 16 Web App\nfasthelp-kappa.vercel.app" as Web
  component "Web Push (VAPID)\nlib/push.ts" as Push
  component "Environment Secrets\nVAPID_PRIVATE_KEY · VAPID_SUBJECT" as Secrets
}

cloud "Supabase Cloud (Production)\noaowgicupetabfdxburr" {
  component "Auth" as Auth
  database "PostgreSQL + RLS + Trigger" as DB
  component "Realtime\nmessages · booking_reads" as RT
  database "Storage chat-images (private)" as Store
}

cloud "บริการภายนอก" as External {
  component "Google Maps" as Maps
}

GH --> CI : deploy อัตโนมัติเมื่อ push main
CI --> Web
Browser --> Web : HTTPS
Web --> Auth : cookie session
Web --> DB : SQL ผ่าน PostgREST
Web <--> RT : WebSocket
Web --> Store : signed URL
Web --> Maps
Web --> Secrets
Web --> Push
Push --> DB : push_subscriptions
Push --> Browser : แจ้งเตือนผ่าน Push Service (VAPID)
Browser --> SW : ลงทะเบียน / รับ event
SW --> Web : notificationclick เปิดหน้างาน

note right of Web
  Production alias: https://fasthelp-kappa.vercel.app
  NEXT_PUBLIC_APP_URL · NEXT_PUBLIC_SUPABASE_URL
  NEXT_PUBLIC_SUPABASE_ANON_KEY (publishable)
  NEXT_PUBLIC_VAPID_PUBLIC_KEY (publishable)
  NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (optional)
  เฉพาะ key ที่ขึ้น NEXT_PUBLIC_* ส่งถึง browser
end note

note bottom of DB
  รัน supabase/schema.sql + ENABLE_WEB_PUSH.sql
  + FIX_ADMIN_LOGIN.sql + FIX_PROVIDER_SELF_VERIFY.sql
end note

@enduml
