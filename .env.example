# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# PromptPay (mock QR) - เบอร์โทรหรือเลขบัตรประชาชนของผู้รับเงิน
NEXT_PUBLIC_PROMPTPAY_ID=0812345678
NEXT_PUBLIC_PROMPTPAY_NAME=FastHelp

# URL ของเว็บที่ deploy แล้ว ใช้สำหรับ Capacitor (mobile wrapper),
# ลิงก์ยืนยันอีเมล/รีเซ็ตรหัสผ่าน และ sitemap/robots
# NEXT_PUBLIC_APP_URL=https://fasthelp.example.com
